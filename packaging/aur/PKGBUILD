# Maintainer: LuisMa <luismaf@gmail.com>
pkgname=climax
pkgver=0.4.3
pkgrel=1
pkgdesc="Claude Code quota guard: JSON statusLine hook + auto-resume over herdr"
arch=('x86_64' 'aarch64')
url="https://github.com/luismaf/climax"
license=('MIT')
depends=('glibc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/luismaf/climax/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
# Requires the 'herdr' daemon running and the Claude Code statusLine hook
# (climax auto-installs it into ~/.claude/settings.json on startup).
# For the systemd user service: 'climax --install' (boot autorun,
# login-less with loginctl enable-linger).

build() {
    cd "$srcdir/climax-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$srcdir/climax-$pkgver"
    install -Dm755 target/release/climax "$pkgdir/usr/bin/climax"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}